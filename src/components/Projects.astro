---
import { useTranslations } from '../i18n';

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const projects = t.projects.list;
---

<section id="work" class="projects">
  <header class="projects__header">
    <span class="projects__label" aria-hidden="true">{t.projects.label}</span>
    <h2 class="projects__heading">{t.projects.heading}</h2>
    <p class="projects__subtitle">{t.projects.subtitle}</p>
  </header>

  <div class="projects__list">
    {projects.map((project, i) => {
      const side = i % 2 === 0 ? 'left' : 'right';
      return (
        <article class={`project project--${side}`} data-index={i}>
          <div class="project__visual" aria-hidden="true">
            <div class="project__visual-inner" style={`background-color: var(--project-bg-${i})`}>
              <span class="project__visual-label">{project.title}</span>
            </div>
          </div>
          <div class="project__info">
            <span class="project__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="project__title">{project.title}</h3>
            <p class="project__description">{project.description}</p>
            <div class="project__meta">
              <span class="project__role">{project.role}</span>
            </div>
            <div class="project__stack">
              {project.stack.map(tech => (
                <span class="project__tech">{tech}</span>
              ))}
            </div>
            <a href={project.url || '#'} class="project__link">
              {t.projects.cta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  :root {
    --project-bg-0: oklch(0.92 0.02 18);
    --project-bg-1: oklch(0.96 0.01 250);
    --project-bg-2: oklch(0.93 0.015 350);
    --project-bg-3: oklch(0.94 0.015 100);
  }

  .projects {
    padding: var(--space-2xl) var(--space-xl) var(--space-2xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects__header {
    margin-bottom: var(--space-2xl);
    max-width: 600px;
  }

  .projects__label {
    font-size: clamp(0.625rem, 0.9vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red);
    display: block;
    margin-bottom: var(--space-md);
  }

  .projects__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .projects__subtitle {
    font-size: clamp(0.875rem, 1.2vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 65ch;
  }

  .projects__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "visual info";
    gap: var(--space-xl);
    align-items: center;
    min-height: 60vh;
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.8s var(--ease-out-expo), transform 0.8s var(--ease-out-expo);
  }

  .project.visible {
    opacity: 1;
    transform: none;
  }

  .project--right {
    grid-template-areas: "info visual";
  }

  .project__visual {
    grid-area: visual;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .project__info {
    grid-area: info;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .project__visual-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project__visual-label {
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 700;
    color: var(--color-ink);
    opacity: 0.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    padding: var(--space-md);
  }

  .project__number {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-red);
    opacity: 0.3;
  }

  .project__title {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .project__description {
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 65ch;
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .project__role {
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .project__tech {
    font-size: clamp(0.6875rem, 0.9vw, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 4px 10px;
    border: 1px solid oklch(0.85 0 0);
    border-radius: 2px;
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: clamp(0.8125rem, 1vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-red);
    margin-top: var(--space-sm);
    transition: gap 0.3s var(--ease-out-quart);
  }

  .project__link:hover {
    gap: var(--space-md);
  }

  .project__link:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .projects {
      padding: var(--space-xl) var(--space-lg);
    }

    .project {
      grid-template-columns: 1fr;
      grid-template-areas: "visual" "info";
      gap: var(--space-lg);
      min-height: auto;
    }

    .project__visual {
      aspect-ratio: 16 / 9;
    }

    .project__number {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll('.project').forEach((el) => observer.observe(el));
</script>
