---
import { useTranslations } from '../i18n';
import { getGitHubMetrics } from '../lib/github';

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

const skillCategories = t.about.skills.categories.map((name, i) => ({
  name,
  skills: t.about.skillsData[i] || [],
}));

const metrics = await getGitHubMetrics('mRezaAnanta');

const repos = metrics.source === 'live' ? metrics.repos.toLocaleString('en-US') : t.about.github.repos;
const stars = metrics.source === 'live' ? metrics.stars.toLocaleString('en-US') : t.about.github.stars;
const followers = metrics.source === 'live' ? metrics.followers.toLocaleString('en-US') : t.about.github.followers;
const contributions = metrics.source === 'live' ? metrics.contributions.toLocaleString('en-US') : t.about.github.contributions;
---

<section id="about" class="about">
  <span class="about__label" aria-hidden="true">{t.about.label}</span>
  <h2 class="about__heading">{t.about.heading}</h2>
  <div class="about__content">
    {t.about.paragraphs.map(p => (
      <p class="about__text">{p}</p>
    ))}
  </div>
  <div class="about__skills">
    <h3 class="about__skills-heading">{t.about.skills.heading}</h3>
    <div class="about__skills-grid">
      {skillCategories.map(cat => (
        <div class="about__skills-category">
          <span class="about__skills-name">{cat.name}</span>
          <div class="about__skills-tags">
            {cat.skills.map(skill => (
              <span class="about__skill-tag">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="about__github">
    <div class="about__github-stat">
      <span class="about__github-number">{repos}</span>
      <span class="about__github-label">{t.about.github.labels.repos}</span>
    </div>
    <div class="about__github-stat">
      <span class="about__github-number">{stars}</span>
      <span class="about__github-label">{t.about.github.labels.stars}</span>
    </div>
    <div class="about__github-stat">
      <span class="about__github-number">{followers}</span>
      <span class="about__github-label">{t.about.github.labels.followers}</span>
    </div>
    <div class="about__github-stat">
      <span class="about__github-number">{contributions}</span>
      <span class="about__github-label">{t.about.github.labels.contributions}</span>
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--space-2xl) var(--space-xl);
    max-width: 720px;
    margin: 0 auto;
  }

  .about__label {
    font-size: clamp(0.625rem, 0.9vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red);
    display: block;
    margin-bottom: var(--space-md);
  }

  .about__heading {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-lg);
  }

  .about__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .about__text {
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 65ch;
  }

  .about__skills {
    border-top: 1px solid oklch(0.88 0 0);
    padding-top: var(--space-xl);
  }

  .about__skills-heading {
    font-size: clamp(0.8125rem, 1vw, 0.875rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
  }

  .about__skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg) var(--space-xl);
  }

  .about__skills-category {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .about__skills-name {
    font-size: clamp(0.6875rem, 0.9vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-red);
  }

  .about__skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .about__skill-tag {
    font-size: clamp(0.6875rem, 0.85vw, 0.75rem);
    font-weight: 500;
    color: var(--color-muted);
    padding: 4px 10px;
    border: 1px solid oklch(0.85 0 0);
    border-radius: 2px;
  }

  .about__github {
    display: flex;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid oklch(0.88 0 0);
  }

  .about__github-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .about__github-number {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .about__github-label {
    font-size: clamp(0.625rem, 0.8vw, 0.6875rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .about {
      padding: var(--space-xl) var(--space-lg);
    }

    .about__skills-grid {
      grid-template-columns: 1fr;
    }

    .about__github {
      flex-direction: column;
      gap: var(--space-lg);
    }
  }
</style>
