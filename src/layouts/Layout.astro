---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';
import Header from '../components/Header.astro';

const locale = Astro.url.pathname.startsWith('/id') ? 'id' : 'en';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Muhammad Reza Ananta — Developer + Designer</title>
    <meta name="description" content="Portfolio of Muhammad Reza Ananta — style meets substance. A developer who treats UI as an art form." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@100..800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header locale={locale} />
    <slot />
    <BackToTop />
  </body>
</html>
