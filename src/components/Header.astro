---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n';

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const home = locale === 'en' ? '/' : '/id/';
const blogIndex = locale === 'en' ? '/blog/' : '/id/blog/';

const navLinks = [
  { label: t.nav.work, href: `${home}#work` },
  { label: t.nav.writing, href: blogIndex },
  { label: t.nav.about, href: `${home}#about` },
  { label: t.nav.resume, href: `${home}#resume` },
  { label: t.nav.contact, href: `${home}#contact` },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={home} class="site-header__brand">MRA<span class="site-header__brand-dot">.</span></a>

    <nav class="site-header__nav" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a href={link.href} class="site-header__link">{link.label}</a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher currentLocale={locale} />
      <button class="site-header__toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-header-mobile">
        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>
      </button>
    </div>
  </div>

  <nav id="site-header-mobile" class="site-header__mobile" aria-label="Primary mobile">
    {
      navLinks.map((link) => (
        <a href={link.href} class="site-header__mobile-link">{link.label}</a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid oklch(0.9 0 0);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-lg);
  }

  .site-header__brand {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .site-header__brand-dot {
    color: var(--color-red);
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-md);
  }

  .site-header__link {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 4px 2px;
    transition: color 0.2s;
  }

  .site-header__link:hover {
    color: var(--color-red);
  }

  .site-header__link:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .site-header__toggle-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    transition: transform 0.3s var(--ease-out-quart), opacity 0.2s;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-line:nth-child(2) {
    opacity: 0;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-header__toggle:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .site-header__mobile {
    display: none;
    flex-direction: column;
    border-top: 1px solid oklch(0.92 0 0);
    padding: var(--space-sm) var(--space-lg) var(--space-md);
  }

  .site-header__mobile-link {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid oklch(0.95 0 0);
  }

  .site-header__mobile-link:hover {
    color: var(--color-red);
  }

  @media (max-width: 768px) {
    .site-header__nav {
      display: none;
    }

    .site-header__toggle {
      display: flex;
    }

    .site-header__mobile.is-open {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__toggle-line {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.site-header__toggle');
  const mobileNav = document.querySelector('.site-header__mobile');

  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const isOpen = mobileNav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
