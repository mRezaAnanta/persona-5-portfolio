---
import { useTranslations } from '../i18n';
import { gsap } from 'gsap';

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<section class="hero" aria-label="Introduction">
  <div class="hero__panel hero__panel--red">
    <span class="hero__label" aria-hidden="true">{t.hero.label}</span>
    <h1 class="hero__name">
      Muhammad<br>
      Reza<br>
      Ananta
    </h1>
    <p class="hero__role">{t.hero.role}</p>
  </div>
  <div class="hero__panel hero__panel--white">
    <p class="hero__tagline">{t.hero.tagline}</p>
    <a href="#work" class="hero__cta">
      {t.hero.cta}
      <span class="hero__cta-arrow" aria-hidden="true">→</span>
    </a>
    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
      <span class="hero__scroll-text">{t.hero.scroll}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    min-height: 100vh;
  }

  .hero__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl);
    position: relative;
  }

  .hero__panel--red {
    flex: 0 0 60%;
    background: var(--color-red);
    color: var(--color-white);
    padding-left: clamp(var(--space-xl), 6vw, var(--space-2xl));
    clip-path: polygon(0 0, 100% 0, calc(100% - 12vw) 100%, 0 100%);
  }

  .hero__panel--white {
    flex: 0 0 40%;
    background: var(--color-white);
    color: var(--color-ink);
    padding-right: clamp(var(--space-xl), 6vw, var(--space-2xl));
  }

  .hero__label {
    font-size: clamp(0.625rem, 1.2vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
    opacity: 0.6;
  }

  .hero__name {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .hero__role {
    font-size: clamp(0.875rem, 1.4vw, 1.125rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: var(--space-lg);
    opacity: 0.75;
  }

  .hero__tagline {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-xl);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: clamp(0.875rem, 1.2vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-red);
    transition: gap 0.3s var(--ease-out-quart), transform 0.2s var(--ease-out-quart);
  }

  .hero__cta:hover {
    gap: var(--space-md);
  }

  .hero__cta:active {
    transform: scale(0.96);
  }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .hero__cta-arrow {
    font-size: 1.25em;
    transition: transform 0.3s var(--ease-out-quart);
  }

  .hero__cta:hover .hero__cta-arrow {
    transform: translateX(4px);
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 32px;
    background: var(--color-red);
  }

  .hero__scroll-text {
    font-size: clamp(0.625rem, 0.9vw, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-red);
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
    }

    .hero__panel--red {
      flex: 0 0 60vh;
      padding: var(--space-xl) var(--space-lg);
      justify-content: flex-end;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14vw), 0 100%);
    }

    .hero__panel--white {
      flex: 0 0 auto;
      padding: var(--space-xl) var(--space-lg);
      min-height: 40vh;
    }

    .hero__name {
      font-size: clamp(2rem, 12vw, 3.5rem);
      line-height: 0.95;
    }

    .hero__scroll {
      display: none;
    }

    .hero__cta {
      margin-top: auto;
    }
  }
</style>

<script>
  (() => {
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const redPanel = document.querySelector('.hero__panel--red');
      const whitePanel = document.querySelector('.hero__panel--white');

      if (redPanel && whitePanel) {
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

        tl.from(redPanel, {
          xPercent: -100,
          duration: 0.9,
          ease: 'power3.inOut',
          immediateRender: false,
        }).from(
          '.hero__label, .hero__name, .hero__role',
          {
            y: 40,
            opacity: 0,
            duration: 0.6,
            stagger: 0.09,
            ease: 'power3.inOut',
          },
          0.25,
        ).from(
          whitePanel,
          {
            scale: 0.85,
            opacity: 0,
            duration: 0.75,
            ease: 'power3.inOut',
          },
          0.45,
        ).from(
          '.hero__scroll',
          {
            y: 20,
            opacity: 0,
            duration: 0.6,
            yoyo: true,
            repeat: -1,
          },
          0.9,
        );
      }
    }
  })();
</script>
